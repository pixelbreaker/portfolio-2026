{
  "name": "portfolio-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "dev": "vite",
    "routes:generate": "tsr generate",
    "build": "pnpm routes:generate && tsc -b && NODE_ENV=production vite build",
    "lint": "pnpm routes:generate && eslint .",
    "typecheck": "pnpm routes:generate && tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "NODE_ENV=production vite preview"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "1.169.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-cli": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "husky": "^9.1.7",
    "prettier": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
